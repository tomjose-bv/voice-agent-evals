# Copy to .env and edit. .env is git-ignored; never commit real secrets.

# --- LLM backend (opt-in: `vae run --agent llm`) -----------------------------
# Any OpenAI-compatible endpoint. Default is a local Ollama server.
VAE_LLM_BASE_URL=http://localhost:11434/v1
VAE_LLM_MODEL=llama3.1:8b
# Ollama ignores the key, but the header must be present.
VAE_LLM_API_KEY=ollama
# Optional separate models for the simulated caller and the LLM judge
# (default: same as VAE_LLM_MODEL).
VAE_CALLER_MODEL=
VAE_JUDGE_MODEL=
VAE_LLM_TIMEOUT_S=120

# --- Business rules -----------------------------------------------------------
VAE_CREDIT_LIMIT=50

# --- Voice demo (`vae serve`) -------------------------------------------------
# faster-whisper model: tiny.en (fastest) or base.en (more accurate)
VAE_STT_MODEL=tiny.en
# auto | piper | sapi | none
VAE_TTS_ENGINE=auto
# Path to a Piper voice .onnx file (its .onnx.json must sit next to it).
# scripts/setup.ps1 -Voice downloads one into ./models/
VAE_PIPER_VOICE=models/en_US-lessac-medium.onnx
